{
  "name": "kickru-edition",
  "version": "1.5.0",
  "description": "벤치에서 발롱까지 : 선수 스탯 에디터 + 구단 감독 3D/2D 매치 + 로컬 폴더 저장 에디션",
  "main": "electron-main.js",
  "scripts": {
    "web": "node server.js",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.kickru.edition",
    "productName": "벤치에서 발롱까지 에디션",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!saves/*.json",
      "!dist/**"
    ]
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
